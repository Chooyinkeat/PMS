@page
@model PMS.Pages.Setup.UserGroupMaintenanceModel
@{
    ViewData["Title"] = "User Group Maintenance";
}

<!-- Page Header -->
<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">
        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">User Group & Access Control</h3>
            <div class="nk-block-des text-soft">
                <p>Manage security roles and define granular module access rights (View, Add, Edit, Delete, Print).</p>
            </div>
        </div>
        <div class="nk-block-head-content">
            <div class="toggle-wrap nk-block-tools-toggle">
                <ul class="nk-block-tools g-3">
                    @if (Model.PagePermission.CanPrint)
                    {
                        <li>
                            <a asp-page="./UserGroupMaintenance" asp-page-handler="ExportPdf"
                               asp-route-searchTerm="@Model.SearchTerm"
                               class="btn btn-outline-secondary">
                                <em class="icon ni ni-printer"></em><span>Export PDF</span>
                            </a>
                        </li>
                    }
                    @if (Model.PagePermission.CanAdd)
                    {
                        <li>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addGroupModal">
                                <em class="icon ni ni-plus"></em><span>Add User Group</span>
                            </button>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-fill alert-success alert-dismissible alert-icon">
        <em class="icon ni ni-check-circle"></em>
        @TempData["SuccessMessage"]
        <button class="close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-fill alert-danger alert-dismissible alert-icon">
        <em class="icon ni ni-cross-circle"></em>
        @TempData["ErrorMessage"]
        <button class="close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filters -->
<div class="card card-bordered mb-4">
    <div class="card-inner py-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-9">
                <label class="form-label">Search</label>
                <div class="form-control-wrap">
                    <div class="form-icon form-icon-left"><em class="icon ni ni-search"></em></div>
                    <input type="text" name="SearchTerm" class="form-control" placeholder="Search by group name or description..." value="@Model.SearchTerm" />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-grow-1"><em class="icon ni ni-filter"></em> Filter</button>
                <a asp-page="./UserGroupMaintenance" class="btn btn-icon btn-light" title="Reset Filters"><em class="icon ni ni-reload"></em></a>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card card-bordered card-preview">
    <div class="card-inner p-0">
        <div class="table-responsive">
            <table class="table table-tranx">
                <thead>
                    <tr class="tb-tnx-head bg-light">
                        <th class="tb-tnx-id"><span class="text-secondary">#</span></th>
                        <th>User Group Name</th>
                        <th>Description</th>
                        <th class="text-center">Assigned Users</th>
                        <th class="text-center">Status</th>
                        <th>Created Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Groups.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <em class="icon ni ni-inbox fs-1 mb-2"></em>
                                <p>No user groups found.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        var counter = Model.Pagination.StartItemIndex;
                        @foreach (var g in Model.Groups)
                        {
                            <tr>
                                <td class="tb-tnx-id"><span class="text-muted small">@(counter++)</span></td>
                                <td>
                                    <div class="user-card">
                                        <div class="user-avatar sm bg-azure-dim text-azure">
                                            <em class="icon ni ni-shield-check"></em>
                                        </div>
                                        <div class="user-name">
                                            <span class="tb-lead">@g.UserGroupName</span>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="tb-sub">@(string.IsNullOrWhiteSpace(g.UserGroupDescription) ? "None" : g.UserGroupDescription)</span></td>
                                <td class="text-center">
                                    <span class="badge badge-dim @(g.UserCount > 0 ? "bg-primary" : "bg-light text-muted")">
                                        @g.UserCount user@(g.UserCount == 1 ? "" : "s")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (g.Status)
                                    {
                                        <span class="badge badge-dot badge-dot-xs bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-dot badge-dot-xs bg-danger">Inactive</span>
                                    }
                                </td>
                                <td><span class="tb-date">@g.CreatedDate.ToString("yyyy-MM-dd")</span></td>
                                <td class="text-end">
                                    <div class="dropdown">
                                        <a href="#" class="dropdown-toggle btn btn-icon btn-trigger" data-bs-toggle="dropdown">
                                            <em class="icon ni ni-more-h"></em>
                                        </a>
                                        <div class="dropdown-menu dropdown-menu-end">
                                            <ul class="link-list-opt no-bdr">
                                                @if (Model.PagePermission.CanEdit)
                                                {
                                                    <li>
                                                        <a href="javascript:void(0)" class="text-primary" onclick="openPermissionsModal(@g.UserGroupId, '@JavaScriptEncoder.Default.Encode(g.UserGroupName)')">
                                                            <em class="icon ni ni-lock-alt"></em><span>Permissions Matrix</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a href="javascript:void(0)" onclick="openEditGroupModal(@g.UserGroupId, '@JavaScriptEncoder.Default.Encode(g.UserGroupName)', '@JavaScriptEncoder.Default.Encode(g.UserGroupDescription ?? "")', @(g.Status ? "true" : "false"))">
                                                            <em class="icon ni ni-edit"></em><span>Edit Details</span>
                                                        </a>
                                                    </li>
                                                }
                                                @if (Model.PagePermission.CanDelete)
                                                {
                                                    <li>
                                                        <a href="javascript:void(0)" class="text-danger" onclick="openDeleteGroupModal(@g.UserGroupId, '@JavaScriptEncoder.Default.Encode(g.UserGroupName)')">
                                                            <em class="icon ni ni-trash"></em><span>Delete Group</span>
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.Pagination.TotalPages > 1)
    {
        <div class="card-inner py-3 border-top">
            <div class="nk-block-between-md g-3">
                <div class="g">
                    <span class="text-muted small">Showing @Model.Pagination.StartItemIndex to @Model.Pagination.EndItemIndex of @Model.Pagination.TotalItems entries</span>
                </div>
                <div class="g">
                    <ul class="pagination justify-content-center justify-content-md-start">
                        <li class="page-item @(!Model.Pagination.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-page="./UserGroupMaintenance"
                               asp-route-currentPage="@(Model.Pagination.CurrentPage - 1)"
                               asp-route-pageSize="@Model.Pagination.PageSize"
                               asp-route-searchTerm="@Model.SearchTerm">Prev</a>
                        </li>
                        @for (int p = 1; p <= Model.Pagination.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Pagination.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-page="./UserGroupMaintenance"
                                   asp-route-currentPage="@p"
                                   asp-route-pageSize="@Model.Pagination.PageSize"
                                   asp-route-searchTerm="@Model.SearchTerm">@p</a>
                            </li>
                        }
                        <li class="page-item @(!Model.Pagination.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-page="./UserGroupMaintenance"
                               asp-route-currentPage="@(Model.Pagination.CurrentPage + 1)"
                               asp-route-pageSize="@Model.Pagination.PageSize"
                               asp-route-searchTerm="@Model.SearchTerm">Next</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal: Add Group -->
<div class="modal fade" id="addGroupModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create User Group</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="CreateGroup">
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="form-label" asp-for="Input.UserGroupName">Group Name <span class="text-danger">*</span></label>
                        <div class="form-control-wrap">
                            <input type="text" asp-for="Input.UserGroupName" class="form-control" required placeholder="e.g. Project Managers" />
                        </div>
                        <span asp-validation-for="Input.UserGroupName" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label" asp-for="Input.UserGroupDescription">Description</label>
                        <div class="form-control-wrap">
                            <textarea asp-for="Input.UserGroupDescription" class="form-control" rows="3" placeholder="Brief description of responsibilities..."></textarea>
                        </div>
                    </div>
                    <div class="custom-control custom-switch">
                        <input type="checkbox" asp-for="Input.Status" class="custom-control-input" id="addGroupStatus" checked />
                        <label class="custom-control-label" for="addGroupStatus">Active Group</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Create Group</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Group -->
<div class="modal fade" id="editGroupModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit User Group</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="EditGroup">
                <input type="hidden" asp-for="Input.UserGroupId" id="editGroupId" />
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="form-label" asp-for="Input.UserGroupName">Group Name <span class="text-danger">*</span></label>
                        <div class="form-control-wrap">
                            <input type="text" asp-for="Input.UserGroupName" id="editGroupName" class="form-control" required />
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label" asp-for="Input.UserGroupDescription">Description</label>
                        <div class="form-control-wrap">
                            <textarea asp-for="Input.UserGroupDescription" id="editGroupDesc" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="custom-control custom-switch">
                        <input type="checkbox" asp-for="Input.Status" class="custom-control-input" id="editGroupStatus" />
                        <label class="custom-control-label" for="editGroupStatus">Active Group</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Permissions Matrix -->
<div class="modal fade" id="permissionsModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <div>
                    <h5 class="modal-title"><em class="icon ni ni-shield-check text-primary me-1"></em> Module Permissions Matrix</h5>
                    <span class="text-soft small">Configuring access for: <strong id="matrixGroupName" class="text-primary"></strong></span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="permissionsLoading" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading permissions...</span>
                    </div>
                </div>
                <div id="permissionsContent" style="display:none;">
                    <div class="alert alert-fill alert-light alert-icon mb-3">
                        <em class="icon ni ni-info"></em>
                        <span>Check the permitted actions for each module. Changes take effect on next access.</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 35%;">Module</th>
                                    <th class="text-center" style="width: 13%;">
                                        <div>View (R)</div>
                                        <button type="button" class="btn btn-xs btn-outline-light text-dark mt-1" onclick="toggleColumn('view')">All</button>
                                    </th>
                                    <th class="text-center" style="width: 13%;">
                                        <div>Add (C)</div>
                                        <button type="button" class="btn btn-xs btn-outline-light text-dark mt-1" onclick="toggleColumn('add')">All</button>
                                    </th>
                                    <th class="text-center" style="width: 13%;">
                                        <div>Edit (U)</div>
                                        <button type="button" class="btn btn-xs btn-outline-light text-dark mt-1" onclick="toggleColumn('edit')">All</button>
                                    </th>
                                    <th class="text-center" style="width: 13%;">
                                        <div>Delete (D)</div>
                                        <button type="button" class="btn btn-xs btn-outline-light text-dark mt-1" onclick="toggleColumn('delete')">All</button>
                                    </th>
                                    <th class="text-center" style="width: 13%;">
                                        <div>Print (P)</div>
                                        <button type="button" class="btn btn-xs btn-outline-light text-dark mt-1" onclick="toggleColumn('print')">All</button>
                                    </th>
                                </tr>
                            </thead>
                            <tbody id="matrixTableBody">
                                <!-- Populated dynamically by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-sm btn-primary" id="savePermissionsBtn" onclick="savePermissions()">
                    <em class="icon ni ni-save"></em> Save Permissions
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Delete Confirmation -->
<div class="modal fade" id="deleteGroupModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title text-white"><em class="icon ni ni-alert-circle me-1"></em> Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="DeleteGroup">
                <input type="hidden" name="id" id="deleteGroupId" />
                <div class="modal-body">
                    <p>Are you sure you want to delete user group <strong id="deleteGroupTitle" class="text-danger"></strong>?</p>
                    <p class="text-soft small">Groups with active assigned user accounts cannot be deleted until all users are reassigned.</p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-danger">Yes, Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        var currentMatrixGroupId = 0;
        var matrixRows = [];

        function openEditGroupModal(id, name, desc, status) {
            document.getElementById('editGroupId').value = id;
            document.getElementById('editGroupName').value = name;
            document.getElementById('editGroupDesc').value = desc;
            document.getElementById('editGroupStatus').checked = status;
            var modal = new bootstrap.Modal(document.getElementById('editGroupModal'));
            modal.show();
        }

        function openDeleteGroupModal(id, name) {
            document.getElementById('deleteGroupId').value = id;
            document.getElementById('deleteGroupTitle').innerText = name;
            var modal = new bootstrap.Modal(document.getElementById('deleteGroupModal'));
            modal.show();
        }

        function openPermissionsModal(id, name) {
            currentMatrixGroupId = id;
            document.getElementById('matrixGroupName').innerText = name;
            document.getElementById('permissionsLoading').style.display = 'block';
            document.getElementById('permissionsContent').style.display = 'none';

            var modal = new bootstrap.Modal(document.getElementById('permissionsModal'));
            modal.show();

            fetch('?handler=Permissions&id=' + id)
                .then(r => r.json())
                .then(data => {
                    document.getElementById('permissionsLoading').style.display = 'none';
                    if (data.success) {
                        matrixRows = data.rows;
                        renderMatrixTable();
                        document.getElementById('permissionsContent').style.display = 'block';
                    } else {
                        alert(data.message || 'Error loading permissions.');
                    }
                })
                .catch(err => {
                    document.getElementById('permissionsLoading').style.display = 'none';
                    alert('Failed to contact server.');
                });
        }

        function renderMatrixTable() {
            var tbody = document.getElementById('matrixTableBody');
            tbody.innerHTML = '';
            matrixRows.forEach((r, idx) => {
                var tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>
                        <span class="fw-bold">${r.moduleName}</span>
                        <div class="text-soft small">${r.moduleCode}</div>
                    </td>
                    <td class="text-center">
                        <input type="checkbox" class="form-check-input perm-view" data-idx="${idx}" ${r.canView ? 'checked' : ''} onchange="matrixRows[${idx}].canView = this.checked">
                    </td>
                    <td class="text-center">
                        <input type="checkbox" class="form-check-input perm-add" data-idx="${idx}" ${r.canAdd ? 'checked' : ''} onchange="matrixRows[${idx}].canAdd = this.checked">
                    </td>
                    <td class="text-center">
                        <input type="checkbox" class="form-check-input perm-edit" data-idx="${idx}" ${r.canEdit ? 'checked' : ''} onchange="matrixRows[${idx}].canEdit = this.checked">
                    </td>
                    <td class="text-center">
                        <input type="checkbox" class="form-check-input perm-delete" data-idx="${idx}" ${r.canDelete ? 'checked' : ''} onchange="matrixRows[${idx}].canDelete = this.checked">
                    </td>
                    <td class="text-center">
                        <input type="checkbox" class="form-check-input perm-print" data-idx="${idx}" ${r.canPrint ? 'checked' : ''} onchange="matrixRows[${idx}].canPrint = this.checked">
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function toggleColumn(col) {
            var inputs = document.querySelectorAll('.perm-' + col);
            if (inputs.length === 0) return;
            var anyUnchecked = Array.from(inputs).some(i => !i.checked);
            inputs.forEach(i => {
                i.checked = anyUnchecked;
                var idx = parseInt(i.getAttribute('data-idx'));
                if (col === 'view') matrixRows[idx].canView = anyUnchecked;
                else if (col === 'add') matrixRows[idx].canAdd = anyUnchecked;
                else if (col === 'edit') matrixRows[idx].canEdit = anyUnchecked;
                else if (col === 'delete') matrixRows[idx].canDelete = anyUnchecked;
                else if (col === 'print') matrixRows[idx].canPrint = anyUnchecked;
            });
        }

        function savePermissions() {
            var btn = document.getElementById('savePermissionsBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';

            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            var payload = {
                userGroupId: currentMatrixGroupId,
                rows: matrixRows
            };

            fetch('?handler=SavePermissions', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(data => {
                btn.disabled = false;
                btn.innerHTML = '<em class="icon ni ni-save"></em> Save Permissions';
                if (data.success) {
                    alert('Permissions for user group updated successfully!');
                    var modalEl = document.getElementById('permissionsModal');
                    var modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                } else {
                    alert(data.message || 'Error saving permissions.');
                }
            })
            .catch(err => {
                btn.disabled = false;
                btn.innerHTML = '<em class="icon ni ni-save"></em> Save Permissions';
                alert('An error occurred while saving permissions.');
            });
        }
    </script>
}
