@page
@model PMS.Pages.Setup.DocMaintenanceModel
@{
    ViewData["Title"] = "Document Center";
}

<!-- Page Header -->
<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">
        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">Document & Reporting Center</h3>
            <div class="nk-block-des text-soft">
                <p>Generate, filter, and export official project management reports in standard PDF document format.</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-gs">
    <!-- Report 1: Project Portfolio Report -->
    <div class="col-md-6 col-xxl-4">
        <div class="card card-bordered h-100">
            <div class="card-inner">
                <div class="d-flex align-items-center mb-3">
                    <div class="user-avatar bg-primary-dim text-primary me-3">
                        <em class="icon ni ni-briefcase"></em>
                    </div>
                    <div>
                        <h5 class="card-title mb-0">Project Portfolio Audit</h5>
                        <span class="text-soft small">Master Project Register Report</span>
                    </div>
                </div>
                <p class="text-muted small">
                    Exports a complete audit of all registered projects, including contract values, client profiles, start and target completion dates, and project statuses.
                </p>
                <form method="get" asp-page-handler="ExportProjectsReport" target="_blank" class="mt-3">
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small">Status Filter</label>
                            <select name="status" class="form-select form-select-sm">
                                <option value="">All Statuses</option>
                                <option value="In Progress">In Progress</option>
                                <option value="Completed">Completed</option>
                                <option value="Pending">Pending</option>
                                <option value="On Hold">On Hold</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Customer</label>
                            <select name="customerId" class="form-select form-select-sm">
                                <option value="">All Clients</option>
                                @foreach (var c in Model.Customers)
                                {
                                    <option value="@c.CustomerId">@c.CustomerName</option>
                                }
                            </select>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-sm btn-outline-primary w-100">
                        <em class="icon ni ni-file-pdf me-1"></em> Generate Portfolio Report (PDF)
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Report 2: Financial Billings & Cashflow -->
    <div class="col-md-6 col-xxl-4">
        <div class="card card-bordered h-100">
            <div class="card-inner">
                <div class="d-flex align-items-center mb-3">
                    <div class="user-avatar bg-success-dim text-success me-3">
                        <em class="icon ni ni-wallet"></em>
                    </div>
                    <div>
                        <h5 class="card-title mb-0">Financial Billing Statement</h5>
                        <span class="text-soft small">Cashflow & Invoicing Audit</span>
                    </div>
                </div>
                <p class="text-muted small">
                    Exports comprehensive ledger of project billings, milestone invoices, payment methods, due dates, paid dates, and collected cash totals.
                </p>
                <form method="get" asp-page-handler="ExportPaymentsReport" target="_blank" class="mt-3">
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small">Status Filter</label>
                            <select name="status" class="form-select form-select-sm">
                                <option value="">All Statuses</option>
                                <option value="Paid">Paid Only</option>
                                <option value="Pending">Pending Only</option>
                                <option value="Overdue">Overdue Only</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Project</label>
                            <select name="projectId" class="form-select form-select-sm">
                                <option value="">All Projects</option>
                                @foreach (var prj in Model.Projects)
                                {
                                    <option value="@prj.ProjectId">@prj.ProjectCode</option>
                                }
                            </select>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-sm btn-outline-success w-100">
                        <em class="icon ni ni-file-pdf me-1"></em> Generate Billing Report (PDF)
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Report 3: Customer Directory & Portfolio -->
    <div class="col-md-6 col-xxl-4">
        <div class="card card-bordered h-100">
            <div class="card-inner">
                <div class="d-flex align-items-center mb-3">
                    <div class="user-avatar bg-azure-dim text-azure me-3">
                        <em class="icon ni ni-building"></em>
                    </div>
                    <div>
                        <h5 class="card-title mb-0">Client Portfolio Directory</h5>
                        <span class="text-soft small">Corporate Clients & Engagements</span>
                    </div>
                </div>
                <p class="text-muted small">
                    Official directory of registered client organizations, active engagement counts, assigned contact persons, and client relationship health.
                </p>
                <div class="mt-4 pt-2">
                    <a asp-page="./DocMaintenance" asp-page-handler="ExportCustomersReport" target="_blank" class="btn btn-sm btn-outline-azure w-100">
                        <em class="icon ni ni-file-pdf me-1"></em> Generate Client Portfolio (PDF)
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Report 4: User Accounts & Roles Audit -->
    <div class="col-md-6 col-xxl-4">
        <div class="card card-bordered h-100">
            <div class="card-inner">
                <div class="d-flex align-items-center mb-3">
                    <div class="user-avatar bg-info-dim text-info me-3">
                        <em class="icon ni ni-shield-check"></em>
                    </div>
                    <div>
                        <h5 class="card-title mb-0">Security & Roles Audit</h5>
                        <span class="text-soft small">System Accounts & Permissions</span>
                    </div>
                </div>
                <p class="text-muted small">
                    Exports an administrative security report of all system accounts, email addresses, assigned security groups, and active statuses.
                </p>
                <div class="mt-4 pt-2">
                    <a asp-page="./UserMaintenance" asp-page-handler="ExportPdf" target="_blank" class="btn btn-sm btn-outline-info w-100">
                        <em class="icon ni ni-file-pdf me-1"></em> Generate Security Audit (PDF)
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Report 5: Locations & Sites Register -->
    <div class="col-md-6 col-xxl-4">
        <div class="card card-bordered h-100">
            <div class="card-inner">
                <div class="d-flex align-items-center mb-3">
                    <div class="user-avatar bg-teal-dim text-teal me-3">
                        <em class="icon ni ni-map-pin"></em>
                    </div>
                    <div>
                        <h5 class="card-title mb-0">Locations & Sites Directory</h5>
                        <span class="text-soft small">Physical Locations Register</span>
                    </div>
                </div>
                <p class="text-muted small">
                    Complete listing of all operational sites, headquarters, delivery addresses, and assigned site focal contact persons.
                </p>
                <div class="mt-4 pt-2">
                    <a asp-page="/Master/Location" asp-page-handler="ExportPdf" target="_blank" class="btn btn-sm btn-outline-teal w-100">
                        <em class="icon ni ni-file-pdf me-1"></em> Generate Sites Register (PDF)
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Report 6: Person In Charge Directory -->
    <div class="col-md-6 col-xxl-4">
        <div class="card card-bordered h-100">
            <div class="card-inner">
                <div class="d-flex align-items-center mb-3">
                    <div class="user-avatar bg-warning-dim text-warning me-3">
                        <em class="icon ni ni-user-check"></em>
                    </div>
                    <div>
                        <h5 class="card-title mb-0">Person In Charge (PIC) Directory</h5>
                        <span class="text-soft small">Key Stakeholders & Liaisons</span>
                    </div>
                </div>
                <p class="text-muted small">
                    Official directory of client representatives, project liaisons, key stakeholders, and assigned site responsibilities.
                </p>
                <div class="mt-4 pt-2">
                    <a asp-page="/Master/PersonInCharge" asp-page-handler="ExportPdf" target="_blank" class="btn btn-sm btn-outline-warning w-100">
                        <em class="icon ni ni-file-pdf me-1"></em> Generate PIC Directory (PDF)
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
