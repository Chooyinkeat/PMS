@page
@model PMS.Pages.Project.ListModel
@{
    ViewData["Title"] = "Project List";
}

<!-- Page Header -->
<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">
        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">Master Project Register</h3>
            <div class="nk-block-des text-soft">
                <p>Register, monitor deliverables, manage timelines, and track project contracts.</p>
            </div>
        </div>
        <div class="nk-block-head-content">
            <div class="toggle-wrap nk-block-tools-toggle">
                <ul class="nk-block-tools g-3">
                    <li>
                        <a asp-page="./Cards" class="btn btn-outline-light">
                            <em class="icon ni ni-grid-alt"></em><span>Cards View</span>
                        </a>
                    </li>
                    @if (Model.PagePermission.CanPrint)
                    {
                        <li>
                            <a asp-page="./List" asp-page-handler="ExportPdf"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-customerFilter="@Model.CustomerFilter"
                               asp-route-statusFilter="@Model.StatusFilter"
                               class="btn btn-outline-secondary">
                                <em class="icon ni ni-printer"></em><span>Export PDF</span>
                            </a>
                        </li>
                    }
                    @if (Model.PagePermission.CanAdd)
                    {
                        <li>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addProjectModal">
                                <em class="icon ni ni-plus"></em><span>Add Project</span>
                            </button>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-fill alert-success alert-dismissible alert-icon">
        <em class="icon ni ni-check-circle"></em>
        @TempData["SuccessMessage"]
        <button class="close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-fill alert-danger alert-dismissible alert-icon">
        <em class="icon ni ni-cross-circle"></em>
        @TempData["ErrorMessage"]
        <button class="close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filters -->
<div class="card card-bordered mb-4">
    <div class="card-inner py-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label">Search</label>
                <div class="form-control-wrap">
                    <div class="form-icon form-icon-left"><em class="icon ni ni-search"></em></div>
                    <input type="text" name="SearchTerm" class="form-control" placeholder="Search by project code, title, or keywords..." value="@Model.SearchTerm" />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Customer</label>
                <select name="CustomerFilter" class="form-select">
                    <option value="">All Customers</option>
                    @foreach (var c in Model.Customers)
                    {
                        <option value="@c.CustomerId" selected="@(Model.CustomerFilter == c.CustomerId)">@c.CustomerName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select name="StatusFilter" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
                    <option value="In Progress" selected="@(Model.StatusFilter == "In Progress")">In Progress</option>
                    <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                    <option value="On Hold" selected="@(Model.StatusFilter == "On Hold")">On Hold</option>
                    <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-grow-1"><em class="icon ni ni-filter"></em> Filter</button>
                <a asp-page="./List" class="btn btn-icon btn-light" title="Reset Filters"><em class="icon ni ni-reload"></em></a>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card card-bordered card-preview">
    <div class="card-inner p-0">
        <div class="table-responsive">
            <table class="table table-tranx">
                <thead>
                    <tr class="tb-tnx-head bg-light">
                        <th class="tb-tnx-id"><span class="text-secondary">#</span></th>
                        <th>Code</th>
                        <th>Project Title</th>
                        <th>Customer</th>
                        <th class="text-end">Contract Price</th>
                        <th class="text-center">Team</th>
                        <th>Timeline</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Projects.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                <em class="icon ni ni-inbox fs-1 mb-2"></em>
                                <p>No projects found matching the criteria.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        var counter = Model.Pagination.StartItemIndex;
                        @foreach (var p in Model.Projects)
                        {
                            var statusClass = p.Status switch
                            {
                                "Completed" => "bg-success",
                                "In Progress" => "bg-info",
                                "Pending" => "bg-warning",
                                "On Hold" => "bg-secondary",
                                "Cancelled" => "bg-danger",
                                _ => "bg-light text-dark"
                            };

                            <tr>
                                <td class="tb-tnx-id"><span class="text-muted small">@(counter++)</span></td>
                                <td>
                                    <a asp-page="./Detail" asp-route-id="@p.ProjectId" class="badge badge-dim bg-outline-primary fw-bold">
                                        @p.ProjectCode
                                    </a>
                                </td>
                                <td>
                                    <a asp-page="./Detail" asp-route-id="@p.ProjectId" class="tb-lead text-primary fw-bold">
                                        @p.ProjectName
                                    </a>
                                </td>
                                <td><span class="tb-sub">@p.CustomerName</span></td>
                                <td class="text-end"><span class="tb-amount">@p.Price.ToString("C2")</span></td>
                                <td class="text-center">
                                    <span class="badge badge-dim @(p.MemberCount > 0 ? "bg-azure" : "bg-light text-muted")">
                                        <em class="icon ni ni-users me-1"></em>@p.MemberCount
                                    </span>
                                </td>
                                <td>
                                    <div class="small">
                                        <div><span class="text-muted">Start:</span> @(p.StartDate?.ToString("yyyy-MM-dd") ?? "-")</div>
                                        <div><span class="text-muted">Due:</span> @(p.DueDate?.ToString("yyyy-MM-dd") ?? "-")</div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-dim @statusClass">@p.Status</span>
                                </td>
                                <td class="text-end">
                                    <div class="dropdown">
                                        <a href="#" class="dropdown-toggle btn btn-icon btn-trigger" data-bs-toggle="dropdown">
                                            <em class="icon ni ni-more-h"></em>
                                        </a>
                                        <div class="dropdown-menu dropdown-menu-end">
                                            <ul class="link-list-opt no-bdr">
                                                <li>
                                                    <a asp-page="./Detail" asp-route-id="@p.ProjectId" class="text-primary">
                                                        <em class="icon ni ni-eye"></em><span>View Details</span>
                                                    </a>
                                                </li>
                                                @if (Model.PagePermission.CanEdit)
                                                {
                                                    <li>
                                                        <a href="javascript:void(0)" onclick="openEditModal(@p.ProjectId, '@JavaScriptEncoder.Default.Encode(p.ProjectCode)', '@JavaScriptEncoder.Default.Encode(p.ProjectName)', @p.CustomerId, @p.Price, '@(p.StartDate?.ToString("yyyy-MM-dd") ?? "")', '@(p.DueDate?.ToString("yyyy-MM-dd") ?? "")', '@JavaScriptEncoder.Default.Encode(p.Status)')">
                                                            <em class="icon ni ni-edit"></em><span>Edit Project</span>
                                                        </a>
                                                    </li>
                                                }
                                                @if (Model.PagePermission.CanDelete)
                                                {
                                                    <li>
                                                        <a href="javascript:void(0)" class="text-danger" onclick="openDeleteModal(@p.ProjectId, '@JavaScriptEncoder.Default.Encode(p.ProjectName)')">
                                                            <em class="icon ni ni-trash"></em><span>Delete Project</span>
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.Pagination.TotalPages > 1)
    {
        <div class="card-inner py-3 border-top">
            <div class="nk-block-between-md g-3">
                <div class="g">
                    <span class="text-muted small">Showing @Model.Pagination.StartItemIndex to @Model.Pagination.EndItemIndex of @Model.Pagination.TotalItems entries</span>
                </div>
                <div class="g">
                    <ul class="pagination justify-content-center justify-content-md-start">
                        <li class="page-item @(!Model.Pagination.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-page="./List"
                               asp-route-currentPage="@(Model.Pagination.CurrentPage - 1)"
                               asp-route-pageSize="@Model.Pagination.PageSize"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-customerFilter="@Model.CustomerFilter"
                               asp-route-statusFilter="@Model.StatusFilter">Prev</a>
                        </li>
                        @for (int p = 1; p <= Model.Pagination.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Pagination.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-page="./List"
                                   asp-route-currentPage="@p"
                                   asp-route-pageSize="@Model.Pagination.PageSize"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-customerFilter="@Model.CustomerFilter"
                                   asp-route-statusFilter="@Model.StatusFilter">@p</a>
                            </li>
                        }
                        <li class="page-item @(!Model.Pagination.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-page="./List"
                               asp-route-currentPage="@(Model.Pagination.CurrentPage + 1)"
                               asp-route-pageSize="@Model.Pagination.PageSize"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-customerFilter="@Model.CustomerFilter"
                               asp-route-statusFilter="@Model.StatusFilter">Next</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal: Add Project -->
<div class="modal fade" id="addProjectModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New Project</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" asp-for="Input.ProjectCode">Project Code <span class="text-danger">*</span></label>
                                <div class="form-control-wrap">
                                    <input type="text" asp-for="Input.ProjectCode" class="form-control" required placeholder="e.g. PRJ-2026-001" />
                                </div>
                                <span asp-validation-for="Input.ProjectCode" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" asp-for="Input.ProjectName">Project Title <span class="text-danger">*</span></label>
                                <div class="form-control-wrap">
                                    <input type="text" asp-for="Input.ProjectName" class="form-control" required placeholder="e.g. Cloud ERP Modernization" />
                                </div>
                                <span asp-validation-for="Input.ProjectName" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" asp-for="Input.CustomerId">Customer / Client <span class="text-danger">*</span></label>
                                <div class="form-control-wrap">
                                    <select asp-for="Input.CustomerId" class="form-select" required>
                                        <option value="">-- Select Customer --</option>
                                        @foreach (var c in Model.Customers)
                                        {
                                            <option value="@c.CustomerId">@c.CustomerName (@c.CustomerCode)</option>
                                        }
                                    </select>
                                </div>
                                <span asp-validation-for="Input.CustomerId" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" asp-for="Input.Price">Contract Price ($) <span class="text-danger">*</span></label>
                                <div class="form-control-wrap">
                                    <input type="number" step="0.01" asp-for="Input.Price" class="form-control" required placeholder="0.00" />
                                </div>
                                <span asp-validation-for="Input.Price" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="form-label" asp-for="Input.StartDate">Start Date</label>
                                <div class="form-control-wrap">
                                    <input type="date" asp-for="Input.StartDate" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="form-label" asp-for="Input.DueDate">Target Due Date</label>
                                <div class="form-control-wrap">
                                    <input type="date" asp-for="Input.DueDate" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="form-label" asp-for="Input.Status">Status</label>
                                <div class="form-control-wrap">
                                    <select asp-for="Input.Status" class="form-select">
                                        <option value="Pending">Pending</option>
                                        <option value="In Progress">In Progress</option>
                                        <option value="Completed">Completed</option>
                                        <option value="On Hold">On Hold</option>
                                        <option value="Cancelled">Cancelled</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="form-label" asp-for="Input.Description">Scope & Description</label>
                                <div class="form-control-wrap">
                                    <textarea asp-for="Input.Description" class="form-control" rows="3" placeholder="Key deliverables, objectives, scope..."></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="form-label" asp-for="Input.Remark">Remark / Internal Notes</label>
                                <div class="form-control-wrap">
                                    <textarea asp-for="Input.Remark" class="form-control" rows="2" placeholder="Billing schedules, special terms..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Create Project</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Project -->
<div class="modal fade" id="editProjectModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Project</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Edit">
                <input type="hidden" asp-for="Input.ProjectId" id="editPrjId" />
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" asp-for="Input.ProjectCode">Project Code <span class="text-danger">*</span></label>
                                <div class="form-control-wrap">
                                    <input type="text" asp-for="Input.ProjectCode" id="editPrjCode" class="form-control" required />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" asp-for="Input.ProjectName">Project Title <span class="text-danger">*</span></label>
                                <div class="form-control-wrap">
                                    <input type="text" asp-for="Input.ProjectName" id="editPrjName" class="form-control" required />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" asp-for="Input.CustomerId">Customer / Client <span class="text-danger">*</span></label>
                                <div class="form-control-wrap">
                                    <select asp-for="Input.CustomerId" id="editPrjCustId" class="form-select" required>
                                        @foreach (var c in Model.Customers)
                                        {
                                            <option value="@c.CustomerId">@c.CustomerName (@c.CustomerCode)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label" asp-for="Input.Price">Contract Price ($) <span class="text-danger">*</span></label>
                                <div class="form-control-wrap">
                                    <input type="number" step="0.01" asp-for="Input.Price" id="editPrjPrice" class="form-control" required />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="form-label" asp-for="Input.StartDate">Start Date</label>
                                <div class="form-control-wrap">
                                    <input type="date" asp-for="Input.StartDate" id="editPrjStart" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="form-label" asp-for="Input.DueDate">Target Due Date</label>
                                <div class="form-control-wrap">
                                    <input type="date" asp-for="Input.DueDate" id="editPrjDue" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="form-label" asp-for="Input.Status">Status</label>
                                <div class="form-control-wrap">
                                    <select asp-for="Input.Status" id="editPrjStatus" class="form-select">
                                        <option value="Pending">Pending</option>
                                        <option value="In Progress">In Progress</option>
                                        <option value="Completed">Completed</option>
                                        <option value="On Hold">On Hold</option>
                                        <option value="Cancelled">Cancelled</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Delete Confirmation -->
<div class="modal fade" id="deleteProjectModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title text-white"><em class="icon ni ni-alert-circle me-1"></em> Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Delete">
                <input type="hidden" name="id" id="deletePrjIdInput" />
                <div class="modal-body">
                    <p>Are you sure you want to delete project <strong id="deletePrjNameTitle" class="text-danger"></strong>?</p>
                    <p class="text-soft small">Deleting this project will also delete all associated payment records and team member assignments.</p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-danger">Yes, Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditModal(id, code, name, custId, price, start, due, status) {
            document.getElementById('editPrjId').value = id;
            document.getElementById('editPrjCode').value = code;
            document.getElementById('editPrjName').value = name;
            document.getElementById('editPrjCustId').value = custId;
            document.getElementById('editPrjPrice').value = price;
            document.getElementById('editPrjStart').value = start;
            document.getElementById('editPrjDue').value = due;
            document.getElementById('editPrjStatus').value = status;
            var modal = new bootstrap.Modal(document.getElementById('editProjectModal'));
            modal.show();
        }

        function openDeleteModal(id, name) {
            document.getElementById('deletePrjIdInput').value = id;
            document.getElementById('deletePrjNameTitle').innerText = name;
            var modal = new bootstrap.Modal(document.getElementById('deleteProjectModal'));
            modal.show();
        }
    </script>
}
