@page
@model PMS.Pages.Project.CardsModel
@{
    ViewData["Title"] = "Project Cards";
}

<!-- Page Header -->
<div class="nk-block-head nk-block-head-sm">
    <div class="nk-block-between">
        <div class="nk-block-head-content">
            <h3 class="nk-block-title page-title">Project Board & Cards</h3>
            <div class="nk-block-des text-soft">
                <p>Visual workspace overview of active, completed, and pending projects.</p>
            </div>
        </div>
        <div class="nk-block-head-content">
            <ul class="nk-block-tools g-3">
                <li>
                    <a asp-page="./List" class="btn btn-outline-light">
                        <em class="icon ni ni-list-thumb"></em><span>Table View</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card card-bordered mb-4">
    <div class="card-inner py-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label">Search</label>
                <div class="form-control-wrap">
                    <div class="form-icon form-icon-left"><em class="icon ni ni-search"></em></div>
                    <input type="text" name="SearchTerm" class="form-control" placeholder="Search by title, code or scope..." value="@Model.SearchTerm" />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Customer</label>
                <select name="CustomerFilter" class="form-select">
                    <option value="">All Customers</option>
                    @foreach (var c in Model.Customers)
                    {
                        <option value="@c.CustomerId" selected="@(Model.CustomerFilter == c.CustomerId)">@c.CustomerName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select name="StatusFilter" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
                    <option value="In Progress" selected="@(Model.StatusFilter == "In Progress")">In Progress</option>
                    <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                    <option value="On Hold" selected="@(Model.StatusFilter == "On Hold")">On Hold</option>
                    <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-grow-1"><em class="icon ni ni-filter"></em> Filter</button>
                <a asp-page="./Cards" class="btn btn-icon btn-light" title="Reset"><em class="icon ni ni-reload"></em></a>
            </div>
        </form>
    </div>
</div>

<!-- Project Cards Grid -->
@if (Model.Projects.Count == 0)
{
    <div class="card card-bordered">
        <div class="card-inner text-center py-5">
            <em class="icon ni ni-inbox fs-1 text-muted mb-2"></em>
            <h5 class="text-muted">No projects found</h5>
            <p class="text-soft">Try adjusting your search criteria or register a new project.</p>
            <a asp-page="./List" class="btn btn-sm btn-primary mt-2">Go to Project List</a>
        </div>
    </div>
}
else
{
    <div class="row g-gs">
        @foreach (var p in Model.Projects)
        {
            var badgeClass = p.Status switch
            {
                "Completed" => "bg-success",
                "In Progress" => "bg-info",
                "Pending" => "bg-warning",
                "On Hold" => "bg-secondary",
                "Cancelled" => "bg-danger",
                _ => "bg-light text-dark"
            };

            <div class="col-sm-6 col-lg-4">
                <div class="card card-bordered card-stretch h-100">
                    <div class="card-inner d-flex flex-column h-100">
                        <div class="pms-project-head mb-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge badge-outline-primary fw-bold">@p.ProjectCode</span>
                                <span class="badge badge-dim @badgeClass">@p.Status</span>
                            </div>
                            <h5 class="title mt-2">
                                <a asp-page="./Detail" asp-route-id="@p.ProjectId" class="text-dark">@p.ProjectName</a>
                            </h5>
                            <div class="sub-text text-soft">
                                <em class="icon ni ni-building me-1"></em>@p.CustomerName
                            </div>
                            @if (!string.IsNullOrWhiteSpace(p.Description))
                            {
                                <p class="text-soft small mt-2 mb-0" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @p.Description
                                </p>
                            }
                        </div>

                        <!-- Price & Payment Collection -->
                        <div class="project-details my-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-soft small">Payment Collected</span>
                                <span class="fw-bold text-dark small">@p.TotalPaid.ToString("C0") / @p.Price.ToString("C0")</span>
                            </div>
                            <div class="progress progress-sm">
                                <div class="progress-bar @(p.PaymentPercent >= 100 ? "bg-success" : "bg-primary")"
                                     style="width: @(p.PaymentPercent)%;"></div>
                            </div>
                            <div class="d-flex justify-content-between text-soft small mt-1">
                                <span>@(p.PaymentPercent)% Paid</span>
                                <span>Balance: @(Math.Max(0, p.Price - p.TotalPaid).ToString("C0"))</span>
                            </div>
                        </div>

                        <!-- Team & Due Date -->
                        <div class="project-meta pt-2 border-top d-flex justify-content-between align-items-center">
                            <div class="user-avatar-group">
                                @if (p.MemberInitials.Count == 0)
                                {
                                    <span class="text-soft small fst-italic">No team assigned</span>
                                }
                                else
                                {
                                    @foreach (var init in p.MemberInitials)
                                    {
                                        <div class="user-avatar xs bg-primary-dim text-primary" title="Team Member">
                                            <span>@init</span>
                                        </div>
                                    }
                                    @if (p.TotalMembers > 4)
                                    {
                                        <div class="user-avatar xs bg-light text-soft" title="@(p.TotalMembers - 4) more members">
                                            <span>+@(p.TotalMembers - 4)</span>
                                        </div>
                                    }
                                }
                            </div>
                            <div>
                                @if (p.IsOverdue)
                                {
                                    <span class="badge badge-dim bg-danger" title="Overdue Target Date">
                                        <em class="icon ni ni-clock me-1"></em>@(p.DueDate?.ToString("dd MMM yyyy") ?? "")
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-dim bg-light text-soft" title="Target Due Date">
                                        <em class="icon ni ni-calendar me-1"></em>@(p.DueDate?.ToString("dd MMM yyyy") ?? "No date")
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="mt-auto pt-3 text-end">
                            <a asp-page="./Detail" asp-route-id="@p.ProjectId" class="btn btn-sm btn-outline-primary w-100">
                                <span>Manage Project & Team</span> <em class="icon ni ni-arrow-right ms-1"></em>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
